# Copy to .env and fill in. Both providers have free tiers.
DEEPGRAM_API_KEY=   # https://console.deepgram.com  (STT + TTS, free credit)
GROQ_API_KEY=       # https://console.groq.com      (LLM, free tier)

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low
# STT_MODEL=nova-3
# TTS_VOICE=aura-2-thalia-en
# LOG_LEVEL=INFO
# LOG_FORMAT=text                  # "json" for production log aggregators

# ── Environment ──────────────────────────────────────────────────────────
# ENVIRONMENT=dev                  # "prod" enforces WS_TOKEN_SECRET + production checks

# ── Infrastructure (production mode — leave blank for dev mode) ──────────
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://postgres@localhost:5432/voiceagent

# ── LiveKit (production media transport) ─────────────────────────────────
# LIVEKIT_URL=wss://my-livekit.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ── Security ─────────────────────────────────────────────────────────────
# WS_TOKEN_SECRET=<random-64-char-string>   # MUST set in production
# WS_TOKEN_TTL_SECS=60

# ── Session / Dispatcher ─────────────────────────────────────────────────
# LEASE_TTL_SECS=15
# START_TIMEOUT_SECS=10.0
# DEFAULT_MAX_CONCURRENT_CALLS=10

# ── Agent Worker Fleet ───────────────────────────────────────────────────
# WORKER_MAX_CALLS=4               # processes per node (1 call per process)
# WORKER_WARM_POOL=1               # idle, model-loaded processes kept ready

# ── Post-Call ────────────────────────────────────────────────────────────
# SUMMARY_MODEL=openai/gpt-oss-20b # leave empty to skip LLM summary

# ── Speaker lock ─────────────────────────────────────────────────────────
# SPEAKER_GATE_ENABLED=true
# SPEAKER_THRESHOLD_RATIO=0.8     # agent ignores YOU -> lower (0.65); others get through -> raise (0.9)
# SPEAKER_SPEAKING_BOOST=1.2      # extra strictness while the agent is talking (anti-interruption)

# ── Debug (disable in production: privacy + disk) ────────────────────────
# DEBUG_DIR=debug
